
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-next-level",
  "main": "worker.js",
  "compatibility_date": "2026-11-24",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "ai": {
    "binding": "AI"
  },
  "observability": {
    "enabled": true
  }
}
